{
  "name": "EchoMoteur",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bullseye",

  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },

  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": { "label": "Desktop noVNC (GUI Tkinter)" }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
